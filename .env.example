DATABASE_URL=postgresql://project:CHANGE_ME@postgres:5432/project_back?schema=public

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
JWT_PASSWORD_RESET_SECRET=change-me
JWT_PASSWORD_RESET_EXPIRES_IN=1h
JWT_EMAIL_CONFIRM_SECRET=change-me
JWT_EMAIL_CONFIRM_EXPIRES_IN=24h

CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
# Публичный URL API (для логотипа в письмах: {PUBLIC_API_URL}/assets/mail/Primary.png)
PUBLIC_API_URL=http://localhost:3010

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
SMTP_ENABLED=false

# Redis (BullMQ mail queue + chat email throttle). Local: docker compose up -d
REDIS_URL=redis://localhost:6379
# Окно throttle email по чату (мс), по умолчанию 10 мин
# CHAT_EMAIL_THROTTLE_MS=600000

AWS_REGION=
AWS_BUCKET_NAME=
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BASE_URL=

# app.example.com + api.example.com = same-site → предпочтительно lax.
# none нужен только если фронт и API на разных eTLD+1.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Общий родительский домен (опционально): .example.com
# COOKIE_DOMAIN=.example.com

PORT=3010

# Sentry (optional). Empty = disabled.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web Push (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@nikssens.com
