generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  COMPANY
  MANAGER
}

enum MembershipRole {
  OWNER
  ADMIN
}

enum MessageActorKind {
  OWNER
  MANAGER
}

enum PostAuthorType {
  CREATOR
  COMPANY
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TELEGRAM
  VK
  OTHER
}

enum PlacementFormat {
  POST
  STORIES
  REELS
  SHORTS
  INTEGRATION
  LIVE
}

enum WorkFormat {
  REMOTE
  ON_SITE
  HYBRID
}

enum EmploymentType {
  STAFF
  ONE_TIME
}

enum BudgetType {
  FIXED
  RANGE
  NEGOTIABLE
  BARTER
}

enum PostCurrency {
  RUB
  USD
}

enum PaymentTerms {
  PREPAY
  POSTPAY
  FIFTY_FIFTY @map("50_50")
  SAFE_DEAL
}

enum ContentStyle {
  LIFESTYLE
  REVIEW
  HUMOR
  EXPERT
  UGC
  UNBOXING
  TUTORIAL
  VLOG
  STORYTELLING
  BEFORE_AFTER
  CHALLENGE
  BUYING
  PODCAST
  INTERVIEW
  ASMR
  EDUCATIONAL
  SPORTS
}

enum UsageRights {
  ORGANIC_ONLY
  PAID_ADS
  FULL_LICENSE
}

enum ApplicationStatus {
  NEW
  VIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TaskStatus {
  PREPARING
  PENDING_APPROVAL
  IN_PROGRESS
  CHECKING
  REVISION
  COMPLETED
  ANNULLED
}

enum TaskActivityType {
  STATUS_CHANGED
  FIELD_UPDATED
  MEDIA_ADDED
  MEDIA_REMOVED
  ANNULMENT_REQUESTED
  ANNULMENT_CONFIRMED
  ANNULMENT_REJECTED
  DEADLINE_EXTENSION_REQUESTED
  DEADLINE_EXTENSION_CONFIRMED
  DEADLINE_EXTENSION_REJECTED
}

enum TaskRequestInitiator {
  CUSTOMER
  EXECUTOR
  MUTUAL
}

enum TaskRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TaskMediaKind {
  MAIN
  REPORT
}

enum NotificationType {
  APPLICATION_NEW
  APPLICATION_STATUS_CHANGED
  APPLICATION_WITHDRAWN
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_EXECUTOR_ASSIGNED
  TASK_ASSIGNEE_ASSIGNED
  TASK_COMMENT_CREATED
  TASK_MEDIA_ADDED
  TASK_DEADLINE_SOON
  TASK_DEADLINE_TODAY
  TASK_DEADLINE_OVERDUE
  CHAT_MESSAGE
  TEAM_INVITE
  MEMBERSHIP_REVOKED
  PUBLICATION_CREATED
}

enum MessengerProvider {
  TELEGRAM
  MAX
}

enum MessengerConnectionStatus {
  ACTIVE
  REVOKED
}

enum PublicationStatus {
  PUBLISHED
}

enum DashboardTileType {
  PENDING_ACTION
  PENDING_EXECUTOR_ASSIGN
  NO_EXECUTOR_ASSIGN
  OVERDUE
  URGENT
  CHECKING
  CANCELLED
}

enum PrimeStatus {
  NONE
  ACTIVE
  EXPIRED
  CANCELED
}

enum MessagePinScope {
  PERSONAL
  SHARED
}

model Account {
  id                      String              @id @default(uuid())
  email                   String              @unique
  password                String
  memberships             AccountMembership[]
  invites                 AccountInvite[]
  messages                Message[]
  taskComments            TaskComment[]       @relation("TaskCommentActorAccount")
  taskActivities          TaskActivity[]      @relation("TaskActivityActorAccount")
  notifications           Notification[]      @relation("NotificationActorAccount")
  createdApplications     PostApplication[]   @relation("ApplicationCreatedActorAccount")
  lastActedApplications   PostApplication[]   @relation("ApplicationLastActorAccount")
  assignedTasks           Task[]              @relation("TaskAssigneeAccount")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model AccountMembership {
  id        String         @id @default(uuid())
  accountId String
  userId    String
  role      MembershipRole
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
}

model AccountInvite {
  id         String         @id @default(uuid())
  userId     String
  inviterId  String
  email      String
  role       MembershipRole
  token      String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter    Account        @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([email])
  @@index([userId])
}

model User {
  id                       String                    @id @default(uuid())
  email                    String
  role                     Role
  primeStatus              PrimeStatus               @default(NONE)
  primeExpiresAt           DateTime?
  primeStartedAt           DateTime?
  creatorProfile           CreatorProfile?
  companyProfile           CompanyProfile?
  memberships              AccountMembership[]
  invites                  AccountInvite[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  contacts                 Json?
  person                   Json?
  phone                    String?
  location                 String?
  avatar                   String?
  bio                      String?
  isVerified               Boolean                   @default(false)
  isEmailConfirmed         Boolean                   @default(false)
  aboutMe                  String?
  banner                   String?
  posts                    Post[]
  favoriteGroups           FavoriteGroup[]
  favoritePosts            FavoritePost[]
  favoriteUsers            FavoriteUser[]            @relation("FavoriteUserOwner")
  favoritedByUsers         FavoriteUser[]            @relation("FavoriteUserTarget")
  applications             PostApplication[]         @relation("PostApplications")
  ownedTasks               Task[]                    @relation("OwnedTasks")
  executedTasks            Task[]                    @relation("ExecutedTasks")
  taskComments             TaskComment[]
  taskCommentReadStates    TaskCommentReadState[]
  taskActivities           TaskActivity[]
  annulmentRequestsMade    TaskAnnulmentRequest[]    @relation("AnnulmentRequestedBy")
  annulmentRequestsResolved TaskAnnulmentRequest[]   @relation("AnnulmentConfirmedBy")
  deadlineExtensionRequestsMade TaskDeadlineExtensionRequest[] @relation("DeadlineExtensionRequestedBy")
  deadlineExtensionRequestsResolved TaskDeadlineExtensionRequest[] @relation("DeadlineExtensionConfirmedBy")
  notifications            Notification[]
  sentNotifications        Notification[]            @relation("NotificationActor")
  deadlineReminderLogs     DeadlineReminderLog[]
  ownedPublications        Publication[]             @relation("OwnedPublications")
  executedPublications     Publication[]             @relation("ExecutedPublications")
  config                   UserConfig?
  messengerConnections     MessengerConnection[]
  messengerLinkTokens      MessengerLinkToken[]
  messagePins             MessagePin[]
  hiddenMessages          MessageHidden[]
  taskCommentPins         TaskCommentPin[]
}

model UserConfig {
  id                        String              @id @default(uuid())
  userId                    String              @unique
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppNotificationTypes    NotificationType[]
  emailNotificationTypes    NotificationType[]
  telegramNotificationTypes NotificationType[]
  maxNotificationTypes      NotificationType[]
  dashboardTiles            DashboardTileType[]
  dashboardShowTasks        Boolean             @default(true)
  dashboardShowActivity     Boolean             @default(true)
  dashboardShowComments     Boolean             @default(true)
  dashboardShowCalendar     Boolean             @default(true)
  dashboardShowChats        Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model MessengerConnection {
  id             String                     @id @default(uuid())
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       MessengerProvider
  externalUserId String
  chatId         String
  username       String?
  status         MessengerConnectionStatus  @default(ACTIVE)
  linkedAt       DateTime                   @default(now())
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([userId, provider])
  @@unique([provider, chatId])
  @@index([userId])
}

model MessengerLinkToken {
  id        String            @id @default(uuid())
  token     String            @unique
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  MessengerProvider
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, provider])
  @@index([expiresAt])
}

model Notification {
  id               String            @id @default(uuid())
  recipientId      String
  recipient        User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actorId          String?
  actor            User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorAccountId   String?
  actorAccount     Account?          @relation("NotificationActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDisplayName String?
  actorKind        MessageActorKind?
  type             NotificationType
  title            String
  body             String?
  payload          Json
  readAt           DateTime?
  createdAt        DateTime          @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([actorAccountId])
}

model Conversation {
  id           String                    @id @default(uuid())
  isNotes      Boolean                   @default(false)
  participants ConversationParticipant[]
  messages     Message[]
  messagePins  MessagePin[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([isNotes])
}

model ConversationParticipant {
  id                    String       @id @default(uuid())
  conversationId        String
  userId                String
  lastReadAt            DateTime?
  /// Одно сообщение, принудительно непрочитанное (бейдж/разделитель), без «всё после него»
  unreadAnchorMessageId String?
  /// Чат помечен непрочитанным вручную (точка в списке), без непрочитанных сообщений
  isMarkedUnread        Boolean      @default(false)
  isPinned              Boolean      @default(false)
  pinnedAt              DateTime?
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                        String            @id @default(uuid())
  conversationId            String
  senderId                  String
  /// Account, от имени которого отправили (логин владельца или менеджера)
  actorAccountId            String?
  /// Снимок имени актёра на момент отправки
  actorDisplayName          String?
  /// OWNER — основная компания/креатор; MANAGER — менеджер аккаунта
  actorKind                 MessageActorKind?
  content                   String
  editedAt                  DateTime?
  isRedirected              Boolean           @default(false)
  redirectedFromUserId      String?
  redirectedFromDisplayName String?
  replyToId                 String?
  replyTo                   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies                   Message[]         @relation("MessageReplies")
  replyToPreview            String?
  replyToSenderId           String?
  replyToSenderName         String?
  createdAt                 DateTime          @default(now())
  conversation              Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  actorAccount              Account?          @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  media                     MessageMedia[]
  messagePins               MessagePin[]
  hiddenFor                 MessageHidden[]

  @@index([conversationId, createdAt])
  @@index([actorAccountId])
  @@index([replyToId])
}

model MessageHidden {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model MessageMedia {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  key       String
  size      String
  mimeType  String
  /// Оригинальное имя файла при загрузке (для отображения; в storage — uuid)
  fileName  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessagePin {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  scope      MessagePinScope @default(SHARED)
  pinnedAt   DateTime        @default(now())
  pinnedById String
  pinnedBy   User            @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([messageId, pinnedById])
  @@index([conversationId, pinnedAt])
  @@index([messageId])
}

model CreatorProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  lastName String
}

model CompanyProfile {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
}

model Post {
  id                  String            @id @default(uuid())
  permissions         String[]          @default([])
  title               String
  ownerId             String
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chips               String[]          @default([])
  description         String            @default("")
  urgent              Boolean           @default(false)
  isArchived          Boolean           @default(false)
  isPrivate           Boolean           @default(false)
  keyWords            String[]          @default([])
  categories          String[]          @default([])
  platforms           Platform[]        @default([])
  placementFormats    PlacementFormat[] @default([])
  niche               String[]          @default([])
  tags                String[]          @default([])
  budget              Json?
  deadline            DateTime?
  workFormat          WorkFormat?
  employmentType      EmploymentType?
  location            Json?
  minFollowers        Int?
  maxFollowers        Int?
  minEngagementRate   Float?
  verifiedAccount     Boolean?
  experienceWithAds   Boolean?
  languages           String[]              @default([])
  contentStyle        ContentStyle[]        @default([])
  exclusivity         Boolean?
  exclusivityDays     Int?
  usageRights         UsageRights?
  usageDurationDays   Int?
  requiresMarking     Boolean?
  requiresContract    Boolean?
  ndaRequired         Boolean?
  brief               Json?
  deliverables        Json?
  type                PostAuthorType
  media               PostMedia[]
  favorites           FavoritePost[]
  applications        PostApplication[]
  tasks               Task[]
  publications        Publication[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([ownerId])
  @@index([isArchived])
  @@index([isPrivate])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  key       String
  size      String
  mimeType  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
}

model FavoriteGroup {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  favorites FavoritePost[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model FavoritePost {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId   String?
  group     FavoriteGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([groupId])
}

model FavoriteUser {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation("FavoriteUserOwner", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUserId String
  favoriteUser   User     @relation("FavoriteUserTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([userId, favoriteUserId])
  @@index([userId])
  @@index([favoriteUserId])
}

model PostApplication {
  id                     String            @id @default(uuid())
  postId                 String
  post                   Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicantId            String
  applicant              User              @relation("PostApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  message                String
  status                 ApplicationStatus @default(NEW)
  /// Показывать статистику кандидата владельцу поста
  attachStatistics       Boolean           @default(true)
  createdActorAccountId  String?
  createdActorAccount    Account?          @relation("ApplicationCreatedActorAccount", fields: [createdActorAccountId], references: [id], onDelete: SetNull)
  createdActorDisplayName String?
  createdActorKind       MessageActorKind?
  lastActorAccountId     String?
  lastActorAccount       Account?          @relation("ApplicationLastActorAccount", fields: [lastActorAccountId], references: [id], onDelete: SetNull)
  lastActorDisplayName   String?
  lastActorKind          MessageActorKind?
  task                   Task?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([postId, applicantId])
  @@index([postId])
  @@index([applicantId])
  @@index([status])
  @@index([createdActorAccountId])
  @@index([lastActorAccountId])
}

model Task {
  id                  String                 @id @default(uuid())
  applicationId       String?                @unique
  application         PostApplication?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  postId              String
  post                Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User                   @relation("OwnedTasks", fields: [ownerId], references: [id], onDelete: Cascade)
  executorId          String?
  executor            User?                  @relation("ExecutedTasks", fields: [executorId], references: [id], onDelete: Cascade)
  status              TaskStatus             @default(PREPARING)
  title               String?
  description         String                 @default("")
  finalDate           DateTime?
  photoCount          String                 @default("0")
  videoCount          String                 @default("0")
  urgent              Boolean                @default(false)
  isExecutorApprove   Boolean?
  isCompanyAction     Boolean                @default(true)
  location            Json?
  minFollowers        Int?
  maxFollowers        Int?
  minEngagementRate   Float?
  verifiedAccount     Boolean?
  experienceWithAds   Boolean?
  languages           String[]               @default([])
  contentStyle        ContentStyle[]         @default([])
  exclusivity         Boolean?
  exclusivityDays     Int?
  usageRights         UsageRights?
  usageDurationDays   Int?
  requiresMarking     Boolean?
  requiresContract    Boolean?
  ndaRequired         Boolean?
  brief               Json?
  deliverables        Json?
  /// Аккаунт ответственного на момент создания (кто создал задачу / принял отклик)
  assigneeAccountId   String?
  assigneeAccount     Account?               @relation("TaskAssigneeAccount", fields: [assigneeAccountId], references: [id], onDelete: SetNull)
  assigneeDisplayName String?
  assigneeKind        MessageActorKind?
  media               TaskMedia[]
  comments            TaskComment[]
  commentReadStates   TaskCommentReadState[]
  commentPins         TaskCommentPin[]
  activities          TaskActivity[]
  annulmentRequests   TaskAnnulmentRequest[]
  deadlineExtensionRequests TaskDeadlineExtensionRequest[]
  deadlineReminderLogs DeadlineReminderLog[]
  publication         Publication?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([ownerId])
  @@index([executorId])
  @@index([status])
  @@index([postId])
  @@index([assigneeAccountId])
  @@index([finalDate])
}

model DeadlineReminderLog {
  id          String           @id @default(uuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  finalDate   DateTime
  sentAt      DateTime         @default(now())

  @@unique([taskId, recipientId, type, finalDate])
  @@index([sentAt])
  @@index([recipientId])
}

model TaskAnnulmentRequest {
  id             String               @id @default(uuid())
  taskId         String
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason         String
  initiator      TaskRequestInitiator
  status         TaskRequestStatus    @default(PENDING)
  requestedById  String
  requestedBy    User                 @relation("AnnulmentRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedAt    DateTime             @default(now())
  confirmedById  String?
  confirmedBy    User?                @relation("AnnulmentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([taskId])
  @@index([taskId, status])
  @@index([requestedById])
}

model TaskDeadlineExtensionRequest {
  id                String               @id @default(uuid())
  taskId            String
  task              Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason            String
  initiator         TaskRequestInitiator
  status            TaskRequestStatus    @default(PENDING)
  proposedFinalDate DateTime
  requestedById     String
  requestedBy       User                 @relation("DeadlineExtensionRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedAt       DateTime             @default(now())
  confirmedById     String?
  confirmedBy       User?                @relation("DeadlineExtensionConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([taskId])
  @@index([taskId, status])
  @@index([requestedById])
}

model TaskComment {
  id               String             @id @default(uuid())
  taskId           String
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId         String
  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  actorAccountId   String?
  actorAccount     Account?           @relation("TaskCommentActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDisplayName String?
  actorKind        MessageActorKind?
  content          String
  editedAt         DateTime?
  replyToId        String?
  replyTo          TaskComment?       @relation("TaskCommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          TaskComment[]      @relation("TaskCommentReplies")
  replyToPreview   String?
  replyToSenderId  String?
  replyToSenderName String?
  media            TaskCommentMedia[]
  commentPins      TaskCommentPin[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([taskId])
  @@index([actorAccountId])
  @@index([replyToId])
}

model TaskCommentReadState {
  taskId     String
  userId     String
  lastReadAt DateTime?
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskCommentMedia {
  id        String      @id @default(uuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  key       String
  size      String
  mimeType  String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([commentId])
}

model TaskCommentPin {
  id         String      @id @default(uuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId  String      @unique
  comment    TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  pinnedAt   DateTime    @default(now())
  pinnedById String
  pinnedBy   User        @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@index([taskId, pinnedAt])
}

model TaskMedia {
  id        String        @id @default(uuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      TaskMediaKind @default(MAIN)
  url       String
  key       String
  size      String
  mimeType  String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([taskId])
  @@index([taskId, kind])
}

model TaskActivity {
  id               String            @id @default(uuid())
  taskId           String
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User              @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorAccountId   String?
  actorAccount     Account?          @relation("TaskActivityActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorDisplayName String?
  actorKind        MessageActorKind?
  type             TaskActivityType
  payload          Json
  createdAt        DateTime          @default(now())

  @@index([taskId, createdAt])
  @@index([actorAccountId])
}

model Publication {
  id           String             @id @default(uuid())
  taskId       String             @unique
  task         Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  postId       String
  post         Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User               @relation("OwnedPublications", fields: [ownerId], references: [id], onDelete: Cascade)
  executorId   String?
  executor     User?              @relation("ExecutedPublications", fields: [executorId], references: [id], onDelete: SetNull)
  title         String?
  description   String             @default("")
  externalUrl   String?
  platformLinks Json?
  platform      Platform?
  brief         Json?
  deliverables  Json?
  location      Json?
  status       PublicationStatus  @default(PUBLISHED)
  media        PublicationMedia[]
  publishedAt  DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([ownerId])
  @@index([executorId])
  @@index([postId])
}

model PublicationMedia {
  id                String      @id @default(uuid())
  publicationId     String
  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sourceTaskMediaId String?
  url               String
  key               String
  size              String
  mimeType          String
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())

  @@index([publicationId])
}
